{
	"schemaVersion": 1,
	"id": "fruitfly",
	"version": "${version}",
	"name": "Fruit Fly Connectome",
	"description": "An embodied Drosophila melanogaster in Minecraft: the complete male fruit fly CNS connectome (Janelia FlyEM / Google male-cns v1.0, 125M synapses) simulated as a spiking network that senses the world and drives a fly mob.",
	"authors": [
		"Blendi (fal.ai)"
	],
	"contact": {
		"homepage": "https://github.com/blendi-remade/fly-brain-minecraft",
		"sources": "https://github.com/blendi-remade/fly-brain-minecraft",
		"issues": "https://github.com/blendi-remade/fly-brain-minecraft/issues"
	},
	"license": "MIT",
	"icon": "assets/fruitfly/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.fruitfly.FruitFlyMod"
		],
		"client": [
			"com.fruitfly.client.FruitFlyClient"
		]
	},
	"mixins": [
		"fruitfly.mixins.json",
		{
			"config": "fruitfly.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
